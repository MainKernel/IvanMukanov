{
  // Потрібен для `pnpm typecheck` (tsc --noEmit): без tsconfig.json
  // компілятор не знає, які файли перевіряти, і просто друкує довідку.
  "extends": "../config/tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true
  },
  "include": ["src"]
}


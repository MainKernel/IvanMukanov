generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url = env("DATABASE_URL")
}

enum SeatStatus {
    FREE
    HELD
    SOLD
}

enum Role {
    USER
    ORGANIZER
    ADMIN
}

enum OrderStatus {
    PENDING
    CANCELLED
}

model Venue {
    id String @id @default(uuid(7)) @db.Uuid
    name String
    city String
    events Event[]
    @@index([city])
}

model Event {
    id String @id @default(uuid(7)) @db.Uuid
    title String
    description String?
    startsAt DateTime @db.Timestamptz(3)
    minPriceCents Int
    currency String @default("UAH") @db.Char(3)
    availableSeats Int @default(0)
    venueId String @db.Uuid
    organizerId String @db.Uuid
    createdAt DateTime @default(now()) @db.Timestamptz(3)
    venue Venue @relation(fields: [venueId], references: [id])
    organizer User @relation("OrganizedEvents", fields: [organizerId], references: [id])
    seats Seat[]
    orders Order[]
    @@index([startsAt, id])
    @@index([venueId])
    @@index([organizerId])
}

model Seat {
    id String @id @default(uuid(7)) @db.Uuid
    eventId String @db.Uuid
    rowLabel String
    number Int
    priceCents Int
    status SeatStatus @default(FREE)

    event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

    @@unique([eventId, rowLabel, number])
    @@index([eventId, status])
}

model User {
    id              String   @id @default(uuid(7)) @db.Uuid
    email           String   @unique
    passwordHash    String?
    emailVerified   Boolean  @default(false)
    role            Role     @default(USER)
    createdAt       DateTime @default(now()) @db.Timestamptz(3)

    refreshTokens   RefreshToken[]
    oauthAccounts   OAuthAccount[]
    organizedEvents Event[]  @relation("OrganizedEvents")
    orders          Order[]
}

model OAuthAccount {
    id              String   @id @default(uuid(7)) @db.Uuid
    userId          String   @db.Uuid
    provider        String
    providerSubject String
    createdAt       DateTime @default(now()) @db.Timestamptz(3)

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([provider, providerSubject])
    @@index([userId])
}

model RefreshToken {
    id        String    @id @default(uuid(7)) @db.Uuid
    userId    String    @db.Uuid
    familyId  String    @db.Uuid
    tokenHash String    @unique
    expiresAt DateTime  @db.Timestamptz(3)
    usedAt    DateTime? @db.Timestamptz(3)
    revokedAt DateTime? @db.Timestamptz(3)
    createdAt DateTime  @default(now()) @db.Timestamptz(3)

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([familyId])
    @@index([userId])
}

model Order {
    id         String      @id @default(uuid(7)) @db.Uuid
    userId     String      @db.Uuid
    eventId    String      @db.Uuid
    quantity   Int
    totalCents Int
    currency   String      @default("UAH") @db.Char(3)
    status     OrderStatus @default(PENDING)
    createdAt  DateTime    @default(now()) @db.Timestamptz(3)

    user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
    event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([eventId])
}

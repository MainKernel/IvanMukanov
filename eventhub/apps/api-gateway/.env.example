# Підключення до локальної бази даних PostgreSQL (docker-compose.yaml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eventhub?schema=public"

# Порт, на якому слухає api-gateway
PORT=3000

# Джерело, якому дозволено крос-доменні запити (dev-сервер Vite)
WEB_ORIGIN=http://localhost:5173

# ДЗ ЛР №4: true — PUT/DELETE /favorites відповідають 503 (перевірка відкату оптимістичного оновлення)
FAVORITES_FAIL=false

# ЛР №5: Секрет підпису access-токенів (щонайменше 32 символи; замініть у .env!)
JWT_ACCESS_SECRET="change-me-in-production-at-least-32-chars-long"
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30

# ЛР №6: Вхід через Google (OpenID Connect)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:5173/api/auth/google/callback"

# ЛР №7: Замовлення, резерв місць із TTL та прибиральник
ORDER_HOLD_MINUTES=15      # скільки хвилин замовлення тримає місця
SWEEPER_ENABLED=true       # фоновий прибиральник протермінованих резервів
SWEEPER_BATCH=200          # скільки замовлень прибирати за прохід


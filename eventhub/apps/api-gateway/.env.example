# Підключення до локальної бази даних PostgreSQL (docker-compose.yaml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eventhub?schema=public"

# Порт, на якому слухає api-gateway
PORT=3000

# Джерело, якому дозволено крос-доменні запити (dev-сервер Vite)
WEB_ORIGIN=http://localhost:5173
